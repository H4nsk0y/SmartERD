{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run --no-watch",
    "mutate": "stryker run",
    "coverage": "vitest run --coverage --no-watch",
    "bdd": "cross-env TS_NODE_PROJECT=tsconfig.cucumber.json NODE_OPTIONS=--loader=ts-node/esm cucumber-js --config cucumber.mjs",
    "bdd:watch": "npm run bdd -- --watch",
    "bdd:fast": "cross-env TS_NODE_PROJECT=tsconfig.cucumber.json NODE_OPTIONS=--loader=ts-node/esm cucumber-js --config cucumber.mjs --tags \"not @load\"",
    "bdd:load": "cross-env TS_NODE_PROJECT=tsconfig.cucumber.json NODE_OPTIONS=--loader=ts-node/esm cucumber-js --config cucumber.mjs --tags \"@load\"",
    "report:plots": "node tools/plot_perf.mjs"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@uiw/react-codemirror": "^4.25.3",
    "i18next": "^25.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^16.0.0",
    "react-router-dom": "^7.9.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.0.0",
    "@eslint/js": "^9.36.0",
    "@stryker-mutator/core": "^9.4.0",
    "@stryker-mutator/typescript-checker": "^9.4.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "latest",
    "autoprefixer": "^10.4.21",
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "skia-canvas": "^3.0.8",
    "tailwindcss": "^3.4.18",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^4.0.14"
  }
}
